# Kontaktformular – E-Mail-Versand per SMTP (z. B. das Postfach bei Strato)
# In Vercel unter Project → Settings → Environment Variables eintragen.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@janavogelfotografie.de
SMTP_PASS=
# optional (Standard: info@janavogelfotografie.de bzw. SMTP_USER)
CONTACT_TO=info@janavogelfotografie.de
CONTACT_FROM=info@janavogelfotografie.de

# Automatischer Instagram-Feed – Einrichtung: docs/instagram-feed.md
# Ausschließlich serverseitig und zunächst nur im Vercel-Environment Production.
# Ohne vollständige Konfiguration/erfolgreichen Erstabruf bleibt der Feed verborgen.
CRON_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_AUTH_MODE=instagram-login
# Tatsächliches Ablaufdatum des initialen 60-Tage-Tokens (ISO 8601, UTC).
INSTAGRAM_TOKEN_EXPIRES_AT=
INSTAGRAM_GRAPH_VERSION=v27.0
# Zwei getrennte Blob-Stores; bevorzugt Projektverknüpfung + Vercel OIDC.
INSTAGRAM_PUBLIC_BLOB_STORE_ID=
INSTAGRAM_PRIVATE_BLOB_STORE_ID=
# Optionaler Fallback für lokale Entwicklung: je Store ein Read-write-Token.
INSTAGRAM_PUBLIC_BLOB_READ_WRITE_TOKEN=
INSTAGRAM_PRIVATE_BLOB_READ_WRITE_TOKEN=
