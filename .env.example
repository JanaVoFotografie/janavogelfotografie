# Kontaktformular – E-Mail-Versand per SMTP (z. B. das Postfach bei Strato)
# In Vercel unter Project → Settings → Environment Variables eintragen.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@janavogelfotografie.de
SMTP_PASS=
# optional (Standard: info@janavogelfotografie.de bzw. SMTP_USER)
CONTACT_TO=info@janavogelfotografie.de
CONTACT_FROM=info@janavogelfotografie.de
